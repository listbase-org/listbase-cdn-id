  "meta": {
    "seo_title": "Ukuran Kertas Pixel - Unduh Gratis (Excel/CSV/PDF)",
    "seo_description": "Unduh gratis 33 ukuran kertas standar dengan dimensi mm, inci, & piksel pada 72, 150, 300 PPI. Tersedia dalam format Excel, CSV, PDF.",
    "title": "Kumpulan Data Ukuran Kertas & Dimensi Piksel",
    "description": "Dataset ini menyediakan detail lengkap untuk 33 ukuran kertas umum, termasuk dimensi fisik dalam milimeter dan inci, beserta dimensi piksel untuk resolusi 72, 150, dan 300 PPI.",
    "key_takeaways": [
      "Akses 33 ukuran kertas standar seperti A4, Letter, dan Legal.",
      "Jelajahi dimensi dalam mm, inci, dan piksel pada berbagai PPI.",
      "Unduh konversi piksel yang tepat untuk proyek desain dan cetak.",
      "Gunakan deskripsi penggunaan umum untuk setiap ukuran kertas."
    ],
